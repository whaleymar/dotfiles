let mapleader=" "
map ; :
set relativenumber
set number
map <leader>/ <Action>(CommentByLineComment)
nmap gr <Action>(FindUsages)
nnoremap <leader>ra :action RenameElement<CR>
nnoremap <leader>lo :action ShowErrorDescription<CR>

"These seem to do the same thing. Both steal focus for javadoc
"nnoremap K :action QuickJavaDoc<CR>
nnoremap K :action ShowHoverInfo<CR>

"doesn't work:
"nnoremap <C-n> :action ToggleProjectToolWindow<CR>

inoremap <C-h> <Left>
inoremap <C-j> <Down>
inoremap <C-k> <Up>
inoremap <C-l> <Right>
